<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Poké Lids 2026 分組座標下載器</title>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<style>

/* =========================================================
   BASIC
========================================================= */

*{
  box-sizing:border-box;
}

html,
body{
  margin:0;
  padding:0;
}

body{
  font-family:
    Arial,
    "Noto Sans TC",
    sans-serif;

  max-width:1200px;

  margin:24px auto;

  padding:0 16px;

  background:#f5f6f8;

  color:#222;
}

h1{
  margin:0 0 10px;
}

.box{
  background:#fff;

  padding:18px;

  border-radius:12px;

  margin:12px 0;

  box-shadow:
    0 1px 5px #ddd;
}

button{
  border:0;

  border-radius:8px;

  padding:10px 14px;

  margin:4px;

  cursor:pointer;

  background:#222;

  color:#fff;
}

button:disabled{
  opacity:.5;
}

.grid{
  display:grid;

  grid-template-columns:
    repeat(
      auto-fill,
      minmax(230px,1fr)
    );

  gap:10px;
}

.card{
  background:#fff;

  padding:12px;

  border-radius:10px;

  box-shadow:
    0 1px 4px #ddd;
}

.muted{
  color:#666;

  font-size:13px;
}

code,
pre{
  background:#111;

  color:#eee;

  border-radius:8px;
}

pre{
  padding:12px;

  overflow:auto;
}


/* =========================================================
   MAP
========================================================= */

#map{
  height:700px;

  border-radius:12px;

  overflow:hidden;
}

.map-wrapper{
  position:relative;
}


/* =========================================================
   PREFECTURE TOOLTIP
========================================================= */

.pref-tooltip{
  font-size:14px;

  font-weight:bold;

  padding:7px 10px;
}


/* =========================================================
   PREFECTURE LABEL
========================================================= */

.pref-label{
  background:#222;

  color:#fff;

  border:
    3px solid #fff;

  border-radius:999px;

  padding:
    8px 14px;

  box-shadow:
    0 2px 8px rgba(0,0,0,.35);

  font-size:15px;

  font-weight:bold;

  white-space:nowrap;
}


/* =========================================================
   POKEFUTA DOT
========================================================= */

.poke-dot{
  width:15px;

  height:15px;

  background:#e53935;

  border:
    3px solid #fff;

  border-radius:50%;

  box-shadow:
    0 1px 6px rgba(0,0,0,.55);

  touch-action:manipulation;
}


/* =========================================================
   FLOAT CARD
========================================================= */

#pokeCardOverlay{

  position:fixed;

  inset:0;

  z-index:99999;

  display:none;

  align-items:center;

  justify-content:center;

  pointer-events:none;

  background:
    rgba(0,0,0,.15);
}

#pokeCard{

  width:
    min(
      440px,
      calc(100vw - 24px)
    );

  max-height:
    calc(100vh - 24px);

  overflow:auto;

  background:#fff;

  border-radius:18px;

  box-shadow:
    0 15px 55px
    rgba(0,0,0,.4);

  padding:20px;

  position:relative;

  pointer-events:auto;

  -webkit-overflow-scrolling:touch;

  touch-action:auto;
}


/* =========================================================
   CLOSE
========================================================= */

#pokeCardClose{

  position:absolute;

  right:10px;

  top:10px;

  z-index:5;

  width:40px;

  height:40px;

  padding:0;

  margin:0;

  border-radius:50%;

  background:#222;

  color:#fff;

  font-size:24px;

  line-height:40px;
}


/* =========================================================
   POKEFUTA IMAGE
========================================================= */

#pokeCardImage{

  width:100%;

  max-height:300px;

  object-fit:contain;

  border-radius:12px;

  background:#f3f3f3;

  margin:
    0 0 15px;

  display:none;
}


/* =========================================================
   TITLE
========================================================= */

.poke-title{

  font-size:23px;

  font-weight:bold;

  padding-right:48px;

  margin-bottom:15px;
}


/* =========================================================
   INFO
========================================================= */

.info-row{

  margin:10px 0;

  line-height:1.55;
}


/* =========================================================
   COORDINATE BUTTON
========================================================= */

.coord-button{

  width:100%;

  margin:
    12px 0 0;

  padding:13px;

  background:#f1f1f1;

  color:#222;

  border:
    1px solid #ddd;

  font-family:monospace;

  font-size:15px;

  cursor:pointer;

  touch-action:manipulation;

  user-select:none;

  -webkit-user-select:none;
}

.coord-button:hover{
  background:#e7e7e7;
}

.coord-copied{

  background:#198754 !important;

  color:#fff !important;

  border-color:#198754 !important;
}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:800px){

  body{
    margin:10px auto;

    padding:
      0 10px;
  }

  #map{
    height:620px;
  }

  #pokeCard{

    width:
      calc(100vw - 24px);

    max-height:
      calc(100vh - 24px);

    padding:18px;
  }

  #pokeCardImage{
    max-height:230px;
  }

}


/* =========================================================
   LEAFLET
========================================================= */

.leaflet-tooltip{
  font-size:14px;

  font-weight:bold;
}

</style>
</head>


<body>


<h1>
Poké Lids 2026 分組座標
</h1>


<div class="box">

<p>
<b>資料來源：</b>
GitHub <code>data/data.json</code>
</p>

<p>
