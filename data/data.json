};



/* =========================================================
   COLOR SCALE
========================================================= */

function getMaxCount(){

  return Math.max(
    1,

    ...Object
      .values(groups)
      .map(
        x=>x.length
      )
  );

}


function getPrefColor(count){

  const max=
    getMaxCount();


  if(count<=0){

    return "#e5e7eb";

  }


  /*
    使用平方根比例，

    避免某一個縣數量太多
    導致其他縣全部看起來一樣。

    0 → 淺灰

    少 → 淺藍

    中 → 中藍

    多 → 深藍
  */

  const ratio=
    Math.sqrt(
      count/max
    );


  const start=[
    219,
    234,
    254
  ];

  const end=[
    30,
    64,
    175
  ];


  const r=
    Math.round(
      start[0]+
      (end[0]-start[0])
      *ratio
    );


  const g=
    Math.round(
      start[1]+
      (end[1]-start[1])
      *ratio
    );


  const b=
    Math.round(
      start[2]+
      (end[2]-start[2])
      *ratio
    );


  return `rgb(${r},${g},${b})`;

}



/* =========================================================
   INIT MAP
========================================================= */

function initMap(){

  if(map)
    return;


  map=
    L.map(
      "map",
      {

        zoomControl:true,

        scrollWheelZoom:true,

        doubleClickZoom:true,

        touchZoom:true,

        dragging:true,

        tap:true

      }
    );


  /*
    預設放大一倍：

    原本約 5

    現在 6
  */

  map.setView(
    JAPAN_CENTER,
    6
  );


  /*
    點位 Layer

    一開始完全沒有點
  */

  pointLayer=
    L.layerGroup()
      .addTo(map);


  /*
    =========================
    行政區 GeoJSON
    =========================
  */

  fetch(
    "prefectures.geojson?ts="+Date.now(),
    {
      cache:"no-store"
    }
  )

  .then(r=>{

    if(!r.ok){

      throw Error(
        "prefectures.geojson 載入失敗"
      );

    }

    return r.json();

  })

  .then(geo=>{

    L.geoJSON(

      geo,

      {

        style:function(feature){

          const name=
            getGeoName(
              feature
            );


          const count=
            groups[name]?.length ||
            0;


          return {

            color:"#ffffff",

            weight:1.5,

            fillColor:
              getPrefColor(
                count
              ),

            fillOpacity:.85

          };

        },


        onEachFeature:
        function(
          feature,
          layer
        ){

          const name=
            getGeoName(
              feature
            );


          if(!name)
            return;


          const items=
            groups[name] ||
            [];


          /*
            儲存行政區 Layer
          */

          prefectureLayers[name]=
            layer;


          /*
            =========================
            Hover Tooltip
            =========================
          */

          layer.bindTooltip(

            `<b>
              ${escapeHtml(name)}
            </b>
            ｜${items.length} 個`,

            {

              sticky:true,

              direction:"top",

              className:
                "pref-tooltip"

            }

          );


          /*
            =========================
            Mouse Over
            =========================
          */

          layer.on(
            "mouseover",
            function(){

              layer.setStyle({

                weight:3,

                color:"#222",

                fillOpacity:1

              });

              layer.bringToFront();

            }
          );


          /*
            =========================
            Mouse Out
            =========================
          */

          layer.on(
            "mouseout",
            function(){

              layer.setStyle({

                weight:1.5,

                color:"#fff",

                fillOpacity:.85

              });

            }
          );


          /*
            =========================
            CLICK
            =========================
          */

          layer.on(
            "click",
            function(e){

              if(e)
                L.DomEvent
                  .stopPropagation(e);


              showPrefecture(
                name
              );

            }
          );


          /*
            =========================
            TOUCH
            =========================
          */

          layer.on(
            "touchstart",
            function(e){

              if(e)
                L.DomEvent
                  .stopPropagation(e);

            }
          );


          layer.on(
            "touchend",
            function(e){

              if(e)
                L.DomEvent
                  .stopPropagation(e);


              showPrefecture(
                name
              );

            }
          );

        }

      }

    ).addTo(map);

  })

  .catch(err=>{

    console.error(err);

  });


  /*
    =========================
    地圖空白點擊
    =========================
  */

  map.on(
    "click",
    function(){

      /*
        有選行政區

        → 回日本全圖
      */

      if(
        selectedPrefecture
      ){

        closePokeCard();


        selectedPrefecture=
          null;


        pointLayer.clearLayers();


        map.setView(
          JAPAN_CENTER,
          6,
          {
            animate:true
          }
        );

      }

    }
  );

}



/* =========================================================
   RENDER MAP
========================================================= */

function renderMap(){

  initMap();

}



/* =========================================================
   GEOJSON NAME
========================================================= */

function getGeoName(
  feature
){

  const p=
    feature?.properties || {};


  /*
    常見日本 GeoJSON 欄位
  */

  return (

    p.name ||

    p.nam_ja ||

    p.N03_001 ||

    p.NAME_1 ||

    p.NAME ||

    p.name_ja ||

    p.prefecture ||

    p.pref

  );

}



/* =========================================================
   SHOW PREFECTURE
========================================================= */

function showPrefecture(p){

  const items=
    groups[p] || [];


  selectedPrefecture=
    p;


  closePokeCard();


  /*
    清除舊點
  */

  pointLayer.clearLayers();


  /*
    =========================
    行政區放大
    =========================
  */

  const layer=
    prefectureLayers[p];


  if(layer){

    const bounds=
      layer.getBounds();


    if(
      bounds &&
      bounds.isValid()
    ){

      map.fitBounds(

        bounds,

        {

          padding:[
            60,
            60
          ],

          maxZoom:9,

          animate:true

        }

      );

    }

  }

  else{

    const center=
      PREF_CENTER[p] ||
      JAPAN_CENTER;


    map.setView(
      center,
      8,
      {
        animate:true
      }
    );

  }


  /*
    =========================
    建立 Poké Lid 小點
    =========================
  */

  for(
    const x of items
  ){

    const lat=
      Number(
        x.coords?.[0]
      );


    const lng=
      Number(
        x.coords?.[1]
      );


    if(
      !Number.isFinite(lat) ||
      !Number.isFinite(lng)
    ){

      continue;

    }


    /*
      自訂紅色小點
    */

    const icon=
      L.divIcon({

        className:"",

        html:
          `<div
            class="poke-dot">
          </div>`,

        iconSize:[
          15,
          15
        ],

        iconAnchor:[
          7.5,
          7.5
        ]

      });


    const marker=
      L.marker(

        [
          lat,
          lng
        ],

        {

          icon:icon,

          interactive:true,

          bubblingMouseEvents:false,

          keyboard:true

        }

      );


    marker.addTo(
      pointLayer
    );


    /*
      =========================
      CLICK
      =========================
    */

    marker.on(
      "click",
      function(e){

        if(e)
          L.DomEvent
            .stopPropagation(e);


        showPokeCard(
          x
        );

      }
    );


    /*
      =========================
      MOBILE TOUCH
      =========================
    */

    marker.on(
      "touchstart",
      function(e){

        if(e)
          L.DomEvent
            .stopPropagation(e);

      }
    );


    marker.on(
      "touchend",
      function(e){

        if(e)
          L.DomEvent
            .stopPropagation(e);


        showPokeCard(
          x
        );

      }
    );

  }

}



/* =========================================================
   POKEFUTA IMAGE URL
========================================================= */

function getPokeFutaImage(
  id
){

  if(
    id === undefined ||
    id === null ||
    id === ""
  ){

    return "";

  }


  /*
    原始 Poké Lids Tracker
    的圖片格式：

    /images/pokefuta/{id}.png
  */

  return:

    `https://pokefuta.yuki.games/images/pokefuta/${id}.png`;

}



/* =========================================================
   SHOW POKEFUTA CARD
========================================================= */

function showPokeCard(x){

  const overlay=
    document.getElementById(
      "pokeCardOverlay"
    );


  const title=
    document.getElementById(
      "pokeCardTitle"
    );


  const content=
    document.getElementById(
      "pokeCardContent"
    );


  const image=
    document.getElementById(
      "pokeCardImage"
    );


  /*
    =========================
    ID
    =========================
  */

  const id=
    x.id;


  /*
    =========================
    座標
    =========================
  */

  const lat=
    x.coords?.[0] ?? "";


  const lng=
    x.coords?.[1] ?? "";


  const coord=
    `${lat},${lng}`;


  /*
    =========================
    標題
    =========================
  */

  title.textContent=
    x.city ||
    "Poké Lid";


  /*
    =========================
    圖片
    =========================
  */

  const imageUrl=
    getPokeFutaImage(
      id
    );


  image.onload=
    function(){

      image.style.display=
        "block";

    };


  image.onerror=
    function(){

      console.warn(
        "Poké Lid 圖片載入失敗：",
        imageUrl
      );


      image.style.display=
        "none";

    };


  if(imageUrl){

    image.src=
      imageUrl;

    image.style.display=
      "block";

  }

  else{

    image.removeAttribute(
      "src"
    );

    image.style.display=
      "none";

  }


  /*
    =========================
    資料
    =========================
  */

  content.innerHTML=`

    <div class="info-row">

      <b>ID：</b>

      ${escapeHtml(
        id
      )}

    </div>


    <div class="info-row">

      <b>都道府縣：</b>

      ${escapeHtml(
        PREF[x.pref] ||
        x.pref ||
        ""
      )}

    </div>


    <div class="info-row">

      <b>地點：</b>

      ${escapeHtml(
        x.city ||
        ""
      )}

    </div>


    <div class="info-row">

      <b>地址：</b>

      ${escapeHtml(
        x.address ||
        "無資料"
      )}

    </div>


    <div class="info-row">

      <b>Pokémon：</b>

      ${escapeHtml(
        (x.pokemons || [])
          .join("、") ||
        "無資料"
      )}

    </div>


    <div class="info-row">

      <b>座標：</b>

    </div>


    <button
      id="copyCoordButton"
      class="coord-button"
      type="button">

      📍 ${escapeHtml(coord)}

    </button>

  `;


  /*
    =========================
    複製座標
    =========================
  */

  const copyButton=
    document.getElementById(
      "copyCoordButton"
    );


  function copyCoordinate(e){

    if(e){

      e.preventDefault();

      e.stopPropagation();

    }


    if(

      navigator.clipboard &&

      window.isSecureContext

    ){

      navigator.clipboard
        .writeText(coord)

        .then(()=>{

          copiedFeedback(
            copyButton
          );

        })

        .catch(()=>{

          fallbackCopy(
            coord,
            copyButton
          );

        });

    }

    else{

      fallbackCopy(
        coord,
        copyButton
      );

    }

  }


  copyButton.addEventListener(
    "click",
    copyCoordinate
  );


  copyButton.addEventListener(

    "touchend",

    copyCoordinate,

    {
      passive:false
    }

  );


  copyButton.addEventListener(

    "touchstart",

    function(e){

      e.stopPropagation();

    },

    {
      passive:true
    }

  );


  /*
    =========================
    顯示卡片
    =========================
  */

  overlay.style.display=
    "flex";


  /*
    =========================
    卡片阻止 Leaflet 穿透
    =========================
  */

  L.DomEvent
    .disableClickPropagation(
      document.getElementById(
        "pokeCard"
      )
    );


  L.DomEvent
    .disableScrollPropagation(
      document.getElementById(
        "pokeCard"
      )
    );

}



/* =========================================================
   COPY FALLBACK
========================================================= */

function fallbackCopy(
  text,
  button
){

  const textarea=
    document.createElement(
      "textarea"
    );


  textarea.value=
    text;


  textarea.style.position=
    "fixed";


  textarea.style.left=
    "-9999px";


  document.body.appendChild(
    textarea
  );


  textarea.focus();

  textarea.select();


  try{

    document.execCommand(
      "copy"
    );


    copiedFeedback(
      button
    );

  }

  catch(e){

    alert(
      "複製失敗，請手動複製座標："+
      text
    );

  }


  textarea.remove();

}



/* =========================================================
   COPY FEEDBACK
========================================================= */

function copiedFeedback(
  button
){

  const oldText=
    button.textContent;


  button.textContent=
    "✓ 已複製";


  button.classList.add(
    "coord-copied"
  );


  setTimeout(
    ()=>{

      button.textContent=
        oldText;


      button.classList.remove(
        "coord-copied"
      );

    },
    1500
  );

}



/* =========================================================
   CLOSE CARD
========================================================= */

function closePokeCard(){

  const overlay=
    document.getElementById(
      "pokeCardOverlay"
    );


  overlay.style.display=
    "none";

}



/* =========================================================
   CLOSE BUTTON
========================================================= */

document
  .getElementById(
    "pokeCardClose"
  )
  .addEventListener(
    "click",
    function(e){

      e.preventDefault();

      e.stopPropagation();

      closePokeCard();

    }
  );



/* =========================================================
   CLICK OUTSIDE CARD
========================================================= */

document
  .getElementById(
    "pokeCardOverlay"
  )
  .addEventListener(
    "click",
    function(e){

      if(
        e.target === this
      ){

        closePokeCard();

      }

    }
  );



/* =========================================================
   TOUCH CARD
========================================================= */

document
  .getElementById(
    "pokeCard"
  )
  .addEventListener(
    "touchstart",
    function(e){

      e.stopPropagation();

    },
    {
      passive:true
    }
  );



/* =========================================================
   ESC
========================================================= */

document.addEventListener(
  "keydown",
  function(e){

    if(
      e.key === "Escape"
    ){

      closePokeCard();

    }

  }
);



/* =========================================================
   ESCAPE HTML
========================================================= */

function escapeHtml(s){

  return String(s ?? "")
    .replace(
      /[&<>"']/g,
      m=>({

        "&":"&amp;",
        "<":"&lt;",
        ">":"&gt;",
        '"':"&quot;",
        "'":"&#39;"

      }[m])
    );

}

</script>

</body>
</html>
