<div class="map-wrapper">

<div id="map"></div>

</div>

</div>



<!-- =========================================================
     HISTORY
========================================================= -->

<div class="box">

<h3>
📜 更新 History
</h3>

<p class="muted">

History 由 GitHub Actions 寫入
<code>history.json</code>。

</p>

<div id="history">
載入中…
</div>

</div>



<!-- =========================================================
     GROUPS
========================================================= -->

<div
  id="groups"
  class="grid">
</div>



<!-- =========================================================
     FLOAT CARD
========================================================= -->

<div id="pokeCardOverlay">

