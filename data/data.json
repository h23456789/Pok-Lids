      id="pokeCardTitle"
      class="poke-title">
    </div>


    <div
      id="pokeCardContent">
    </div>

  </div>

</div>



<script
src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
</script>


<script>

/* =========================================================
   DATA
========================================================= */

const DATA_URL =
"https://raw.githubusercontent.com/yukidaruma/pokefuta-tracker/main/data/data.json";


const PREF={

1:"北海道",
2:"青森県",
3:"岩手県",
4:"宮城県",
5:"秋田県",
6:"山形県",
7:"福島県",
8:"茨城県",
9:"栃木県",
10:"群馬県",
11:"埼玉県",
12:"千葉県",
13:"東京都",
14:"神奈川県",
15:"新潟県",
16:"富山県",
17:"石川県",
18:"福井県",
19:"山梨県",
20:"長野県",
21:"岐阜県",
22:"静岡県",
23:"愛知県",
24:"三重県",
25:"滋賀県",
26:"京都府",
27:"大阪府",
28:"兵庫県",
29:"奈良県",
30:"和歌山県",
31:"鳥取県",
32:"島根県",
33:"岡山県",
34:"広島県",
35:"山口県",
36:"徳島県",
37:"香川県",
38:"愛媛県",
39:"高知県",
40:"福岡県",
41:"佐賀県",
42:"長崎県",
43:"熊本県",
44:"大分県",
45:"宮崎県",
46:"鹿児島県",
47:"沖縄県"

};


let data=[];

let groups={};


/* =========================================================
   HISTORY
========================================================= */

async function loadHistory(){

  try{

    const r=
      await fetch(
        "history.json?ts="+Date.now(),
        {
          cache:"no-store"
        }
      );


    if(!r.ok)
      throw Error();


    const h=
      await r.json();


    const el=
      document.getElementById(
        "history"
      );


    const logs=
      h.history || [];


    if(!logs.length){

      el.innerHTML=
        '<span class="muted">尚無更新紀錄。</span>';

      return;
    }


    el.innerHTML=

      logs
      .slice()
      .reverse()
      .slice(0,50)
      .map(item=>{

        const added=
          item.added || [];

        const removed=
          item.removed || [];

        const changed=
          item.changed || [];


        return `

        <div
          class="card"
          style="margin:8px 0">

          <b>
            ${escapeHtml(
              item.time || ""
            )}
          </b>

          <br>

          <span class="muted">

            版本：
            ${item.total ?? ""} 筆

          </span>

          <br>

          🟢 新增 ${added.length}

         　

          🔴 移除 ${removed.length}

         　

          🟡 修改 ${changed.length}


          ${
            added.length ||
            removed.length ||
            changed.length

            ?

            `

            <details>

              <summary>
                查看變更
              </summary>


              ${
                added.length

                ?

                `<b>新增</b><br>

                ${
                  added
                  .map(x=>
                    `＋
                    ${escapeHtml(
                      x.prefecture||""
                    )}
                    ｜
                    ${escapeHtml(
                      x.title||""
                    )}
                    ｜
                    ${x.lat},${x.lng}`
                  )
                  .join("<br>")
                }

                <br>`

                :

                ""
              }


              ${
                removed.length

                ?

                `<b>移除</b><br>

                ${
                  removed
                  .map(x=>
                    `－
                    ${escapeHtml(
                      x.prefecture||""
                    )}
                    ｜
                    ${escapeHtml(
                      x.title||""
                    )}
                    ｜
                    ${x.lat},${x.lng}`
                  )
                  .join("<br>")
                }

                <br>`

                :

                ""
              }


              ${
                changed.length

                ?

                `<b>修改</b><br>

                ${
                  changed
                  .map(x=>
                    `↔
                    ${escapeHtml(
                      x.prefecture||""
                    )}
                    ｜
                    ${escapeHtml(
                      x.title||""
                    )}`
                  )
                  .join("<br>")
                }`

                :

                ""
              }

            </details>

            `

            :

            ""

          }

        </div>

        `;

      })
      .join("");


    document.getElementById(
      "syncInfo"
    ).textContent=

      `GitHub 最新同步：
      ${h.last_sync||"未知"}
      ｜每 5 分鐘自動檢查一次`;

  }

  catch(e){

    document.getElementById(
      "history"
    ).textContent=
      "尚無 History 資料。";

  }

}


/* =========================================================
   LOAD DATA
========================================================= */

fetch(

  DATA_URL+
  "?ts="+Date.now(),

  {
    cache:"no-store"
  }

)

.then(r=>{

  if(!r.ok)
    throw Error(
      "GitHub 資料無法取得"
    );

  return r.json();

})

.then(j=>{

  data=
    Array.isArray(j)
      ? j
      : (j.list || []);


  groups={};


  for(
    const x of data
  ){

    const p=
      PREF[x.pref] ||
      String(x.pref);


    if(!groups[p])
      groups[p]=[];


    groups[p].push(x);

  }


  document.getElementById(
    "status"
  ).textContent=

    `已載入 ${data.length} 筆，
    共 ${Object.keys(groups).length}
    個都道府縣。`;


  ["all","json","csv"]
    .forEach(id=>{

      document
        .getElementById(id)
        .disabled=false;

    });


  render();

  renderMap();

  loadHistory();

})

.catch(e=>{

  document.getElementById(
    "status"
  ).textContent=
    "載入失敗："+e.message;

});



/* =========================================================
   DOWNLOAD
========================================================= */

function safe(s){

  return String(s)
    .replace(
      /[\\/:*?"<>|]/g,
      "_"
    );

}


function blob(
  s,
  type="text/plain;charset=utf-8"
){

  return new Blob(
    ["\ufeff",s],
    {
      type:type
    }
  );

}


function save(b,n){

  const a=
    document.createElement("a");


  a.href=
    URL.createObjectURL(b);


  a.download=n;


  document.body.appendChild(a);

  a.click();

  a.remove();


  setTimeout(
    ()=>{
      URL.revokeObjectURL(
        a.href
      );
    },
    1000
  );

}


function txt(
  items,
  groupName
){

  return items
    .map(x=>

      `${x.coords[0]},
      ${x.coords[1]},
      ${x.city||groupName}`

    )
    .map(x=>
      x.replace(/\s+/g," ")
    )
    .join("\n");

}


function one(p){

  save(

    blob(
      txt(
        groups[p],
        p
      )
    ),

    `${safe(p)}.txt`

  );

}


function downloadAll(){

  let out=[];


  for(
    const p of
    Object.keys(groups).sort()
  ){

    out.push(
      `# ===== ${p} (${groups[p].length}) =====`
    );

    out.push(
      txt(groups[p],p),
      ""
    );

  }


  save(

    blob(
      out.join("\n")
    ),

    "poke_lid_2026_by_prefecture.txt"

  );

}


function downloadJSON(){

  const out={};


  for(
    const p of
    Object.keys(groups).sort()
  ){

    out[p]=

      groups[p]
      .map(x=>({

        lat:
          String(
            x.coords[0]
          ),

        lng:
          String(
            x.coords[1]
          ),

        title:
          String(
            x.city||p
          )

      }));

  }


  save(

    new Blob(

      [
        JSON.stringify(
          out,
          null,
          0
        )
      ],

      {
        type:
          "application/json;charset=utf-8"
      }

    ),

    "poke_lid_2026_favorite_lists.json"

  );

}


function downloadCSV(){

  const rows=[

    [
      "id",
      "prefecture",
      "city",
      "lat",
      "lng",
      "name",
      "address",
      "pokemons"
    ]

  ];


  for(
    const x of data
  ){

    rows.push([

      x.id,

      PREF[x.pref] ||
      x.pref,

      x.city || "",

      x.coords?.[0] || "",

      x.coords?.[1] || "",

      x.city || "",

      x.address || "",

      (x.pokemons||[])
        .join("|")

    ]);

  }


  const csv=

    rows
    .map(r=>

      r.map(v=>

        `"${String(v)
          .replaceAll(
            '"',
            '""'
          )}"`

      ).join(",")

    )
    .join("\n");


  save(

    blob(
      csv,
      "text/csv;charset=utf-8"
    ),

    "poke_lid_2026.csv"

  );

}



/* =========================================================
   GROUP LIST
========================================================= */

function render(){

  const el=
    document.getElementById(
      "groups"
    );


  el.innerHTML="";


  for(
    const p of
    Object.keys(groups).sort()
  ){

    const items=
      groups[p];


    const d=
      document.createElement(
        "div"
      );


    d.className="card";


    d.innerHTML=`

      <b>
        ${escapeHtml(p)}
      </b>

      <br>

      <span class="muted">

        ${items.length}
        個 Poké Lid

      </span>

      <br>

      <button
        onclick='one(${JSON.stringify(p)})'>

        下載此都道府縣 TXT

      </button>

    `;


    el.appendChild(d);

  }

}



/* =========================================================
   MAP
========================================================= */

let map=null;

let prefectureLayers={};

let pointLayer=null;

let selectedPrefecture=null;


/* =========================================================
   JAPAN CENTER
========================================================= */

const JAPAN_CENTER=
  [36.2,138.3];


/* =========================================================
   PREFECTURE CENTER
========================================================= */

const PREF_CENTER={

"北海道":[43.4,142.5],
"青森県":[40.8,140.8],
"岩手県":[39.6,141.4],
"宮城県":[38.4,140.9],
"秋田県":[39.8,140.2],
"山形県":[38.4,140.1],
"福島県":[37.4,140.2],
"茨城県":[36.3,140.4],
"栃木県":[36.7,139.9],
"群馬県":[36.5,138.9],
"埼玉県":[35.9,139.5],
"千葉県":[35.5,140.2],
"東京都":[35.7,139.7],
"神奈川県":[35.4,139.4],
"新潟県":[37.5,138.9],
"富山県":[36.7,137.2],
"石川県":[36.6,136.8],
"福井県":[35.9,136.2],
"山梨県":[35.6,138.6],
"長野県":[36.2,138.0],
"岐阜県":[35.8,137.0],
"静岡県":[35.0,138.4],
"愛知県":[35.1,137.0],
"三重県":[34.7,136.5],
"滋賀県":[35.2,136.1],
"京都府":[35.2,135.6],
"大阪府":[34.7,135.5],
"兵庫県":[35.0,134.8],
"奈良県":[34.6,135.9],
"和歌山県":[33.9,135.2],
"鳥取県":[35.4,133.8],
"島根県":[35.1,132.6],
"岡山県":[34.9,133.8],
"広島県":[34.6,132.8],
"山口県":[34.2,131.5],
"徳島県":[33.9,134.2],
"香川県":[34.3,134.0],
"愛媛県":[33.6,132.8],
